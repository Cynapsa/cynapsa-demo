listening-ip=10.240.90.2
relay-ip=10.240.90.2
listening-port=3478
min-port=50000
max-port=50049
realm=mesh.test
fingerprint
use-auth-secret
static-auth-secret=@CYNAPSA_TURN_STATIC_AUTH_SECRET@
no-tcp
no-tls
no-dtls
no-cli
no-multicast-peers
log-binding
verbose
max-allocate-lifetime=120
permission-lifetime=60
channel-lifetime=60
total-quota=100
user-quota=20
log-file=stdout
simple-log
new-log-timestamp
