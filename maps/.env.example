# Required only while enrolling a new state volume.
CYNAPSA_TOKEN=replace-with-maps-enrollment-token

# Required on every run.
GEMINI_API_KEY=replace-with-gemini-api-key
GOOGLE_MAPS_API_KEY=replace-with-google-maps-api-key

# Required routing configuration.
DEMO_MESH_ID=replace-with-mesh-id

# Optional model override.
# DEMO_GEMINI_MODEL=gemini-3.1-flash-lite
