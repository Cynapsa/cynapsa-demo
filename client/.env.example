# Required only while enrolling a new state volume.
CYNAPSA_TOKEN=replace-with-client-enrollment-token

# Required routing configuration.
DEMO_MESH_ID=replace-with-mesh-id
DEMO_ORCHESTRATOR_AGENT_ID=replace-with-orchestrator-agent-id@connect.cynapsa.com
# Use the real, reachable HTTP origin of the orchestrator in BOTH modes.
# The Cynapsa CLI maps this same origin to DEMO_ORCHESTRATOR_AGENT_ID.
DEMO_ORCHESTRATOR_ORIGIN=https://de-4f1d206529514541bb8cb316c5b0b51e.ecs.us-east-1.on.aws
# Required for ordinary HTTP mode only. Use the same secret configured on
# Orchestrator and Maps; never commit a real value.
# DEMO_HTTP_ACCESS_KEY=replace-with-private-demo-key
# Select HTTP or Cynapsa by moving the # between the two run-command lines
# at the top of run.sh; .env does not choose the mode.
# Optional: reuse a printed conversation ID to resume that chat.
# DEMO_CONVERSATION_ID=replace-with-conversation-id
# Build-only GitHub credential (never passed to the running container).
CYNAPSA_GITHUB_TOKEN=replace-with-github-token

# Optional local metrics: start observability/ first and attach this container
# with CYNAPSA_DEMO_DOCKER_NETWORK=cynapsa-observability in the host shell.
# Keep both exporters off unless you deliberately enable the local collector.
# CYNAPSA_CORE_OTLP_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics
# CYNAPSA_CORE_OTLP_METRICS_INSECURE_DEV=1
# CYNAPSA_SDK_OTLP_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics
# CYNAPSA_SDK_OTLP_METRICS_INSECURE_DEV=1
# CYNAPSA_CORE_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
# CYNAPSA_CORE_OTLP_TRACES_INSECURE_DEV=1
# CYNAPSA_SDK_OTLP_EVENTS_ENDPOINT=http://otel-collector:4318
# CYNAPSA_SDK_OTLP_EVENTS_INSECURE_DEV=1
