CYNAPSA_TOKEN=replace-with-files-enrollment-token
CYNAPSA_GITHUB_TOKEN=replace-with-github-token
DEMO_MESH_ID=replace-with-mesh-id
# Absolute host path; do not quote values in this Docker env file.
DEMO_FILES_DIRECTORY=/absolute/path/to/documents
# Required unless .private/litellm_api_key exists.
LITELLM_API_KEY=replace-with-gateway-or-openai-api-key
LITELLM_BASE_URL=https://litellm.eladrave.com
LITELLM_MODEL=chatgpt/gpt-5.6-terra-high

# Optional local metrics: start observability/ and set the host-shell
# CYNAPSA_DEMO_DOCKER_NETWORK=cynapsa-observability before ./run.sh.
# CYNAPSA_CORE_OTLP_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics
# CYNAPSA_CORE_OTLP_METRICS_INSECURE_DEV=1
# CYNAPSA_SDK_OTLP_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics
# CYNAPSA_SDK_OTLP_METRICS_INSECURE_DEV=1
# CYNAPSA_CORE_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
# CYNAPSA_CORE_OTLP_TRACES_INSECURE_DEV=1
# CYNAPSA_SDK_OTLP_EVENTS_ENDPOINT=http://otel-collector:4318
# CYNAPSA_SDK_OTLP_EVENTS_INSECURE_DEV=1
