{
  "name": "@cynapsa/typescript-sdk-scaffold",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript SDK scaffold for the Cynapsa V1 native ABI",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "example": "node dist/examples/basic.js",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "koffi": "3.1.6"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
