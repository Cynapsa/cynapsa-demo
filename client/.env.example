# Required only while enrolling a new state volume.
CYNAPSA_TOKEN=replace-with-client-enrollment-token

# Required routing configuration.
DEMO_MESH_ID=replace-with-mesh-id
DEMO_ORCHESTRATOR_AGENT_ID=replace-with-orchestrator-agent-id@connect.cynapsa.com
# Use the real, reachable HTTP origin of the orchestrator in BOTH modes.
# The Cynapsa CLI maps this same origin to DEMO_ORCHESTRATOR_AGENT_ID.
DEMO_ORCHESTRATOR_ORIGIN=https://replace-with-orchestrator-http-origin
# Run ordinary HTTP, or intercept the very same requests through Cynapsa.
# DEMO_RUN_COMMAND=python /app/app.py
# DEMO_RUN_COMMAND=cynapsa run -- python /app/app.py
# Optional: reuse a printed conversation ID to resume that chat.
# DEMO_CONVERSATION_ID=replace-with-conversation-id
# Build-only GitHub credential (never passed to the running container).
CYNAPSA_GITHUB_TOKEN=replace-with-github-token
