hosts:
  - mesh.test

loglevel: info
auth_method: internal
auth_password_format: scram
auth_scram_hash: sha256
# PROFILE_SHARED_GROUP_RESOURCE_BEGIN
resource_conflict: closeold
# PROFILE_SHARED_GROUP_RESOURCE_END
ca_file: /opt/ejabberd/conf/ca.pem
certfiles:
  - /opt/ejabberd/conf/server.pem

listen:
  -
    port: 5222
    ip: "0.0.0.0"
    module: ejabberd_c2s
    max_stanza_size: __MAX_STANZA_SIZE__
    access: c2s
    starttls_required: true
  # PROFILE_UPLOAD_LISTENER_BEGIN
  -
    port: 5443
    ip: "0.0.0.0"
    module: ejabberd_http
    tls: true
    request_handlers:
      # PROFILE_UPLOAD_ROUTE_BEGIN
      /upload: __UPLOAD_HANDLER__
      # PROFILE_UPLOAD_ROUTE_END
  # PROFILE_UPLOAD_LISTENER_END

acl:
  local:
    user_regexp: ""

access_rules:
  local:
    allow: local
  c2s:
    allow: all

api_permissions:
  "local test console":
    from: ejabberd_ctl
    who: all
    what: "*"

shaper:
  fast: 1000000

shaper_rules:
  max_user_sessions: 4
  max_user_offline_messages: 100
  c2s_shaper: fast
  s2s_shaper: fast

modules:
  mod_disco: {}
  mod_mam:
    db_type: mnesia
    assume_mam_usage: false
    default: never
    request_activates_archiving: false
  mod_offline:
    db_type: mnesia
    access_max_user_messages: max_user_offline_messages
  mod_ping: {}
  mod_roster: {}
  mod_stream_mgmt:
    resend_on_timeout: if_offline
    resume_timeout: __RESUME_TIMEOUT__
  mod_time: {}
  # PROFILE_EXTDISCO_EMPTY_BEGIN
  mod_stun_disco:
    access: all
    offer_local_services: false
    services: []
  # PROFILE_EXTDISCO_EMPTY_END
  # PROFILE_EXTDISCO_MODULE_BEGIN
  mod_stun_disco:
    access: all
    credentials_lifetime: 2 minutes
    offer_local_services: false
    secret: "__TURN_REST_SECRET__"
    services:
      # PROFILE_EXTDISCO_STUN_BEGIN
      -
        host: stun.test
        port: 3478
        restricted: false
        transport: udp
        type: stun
      # PROFILE_EXTDISCO_STUN_END
      # PROFILE_EXTDISCO_TURN_UDP_BEGIN
      -
        host: turn.test
        port: 3478
        restricted: true
        transport: udp
        type: turn
      # PROFILE_EXTDISCO_TURN_UDP_END
      # PROFILE_EXTDISCO_TURN_TCP_BEGIN
      -
        host: turn.test
        port: 3478
        restricted: true
        transport: tcp
        type: turn
      # PROFILE_EXTDISCO_TURN_TCP_END
  # PROFILE_EXTDISCO_MODULE_END
  # PROFILE_SHARED_GROUP_MODULE_BEGIN
  mod_shared_roster:
    db_type: mnesia
  mod_admin_extra: {}
  mod_cynapsa_mesh:
    mailbox_max_messages: 1024
    mailbox_max_bytes: 67108864
    mailbox_retention_seconds: 86400
    mailbox_audit_log: true
  # PROFILE_SHARED_GROUP_MODULE_END
  # PROFILE_UPLOAD_MODULE_BEGIN
  mod_http_upload:
    put_url: "__PUT_URL__"
    max_size: __MAX_UPLOAD_SIZE__
    docroot: /opt/ejabberd/upload
  # PROFILE_UPLOAD_MODULE_END
