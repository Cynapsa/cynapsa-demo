# Required only while enrolling a new state volume.
CYNAPSA_TOKEN=replace-with-maps-enrollment-token

# Required on every run, unless .private/litellm_api_key is present.
# LITELLM_API_KEY=replace-with-gateway-api-key
GOOGLE_MAPS_API_KEY=replace-with-google-maps-api-key

# Required routing configuration.
DEMO_MESH_ID=replace-with-mesh-id
# Optional mode switch; the default is the first command.
# DEMO_RUN_COMMAND=cynapsa run --config /tmp/cynapsa-private/cynapsa.json -- app:app
# DEMO_RUN_COMMAND=uvicorn app:app --host 0.0.0.0 --port 8000 --no-access-log
# Required only for ordinary HTTP mode, and shared with Client and Orchestrator.
# DEMO_HTTP_ACCESS_KEY=replace-with-private-demo-key
# Optional friendly label for incoming orchestrator log lines.
# DEMO_ORCHESTRATOR_AGENT_ID=replace-with-orchestrator-agent-id@connect.cynapsa.com

# Optional gateway overrides.
# LITELLM_BASE_URL=https://litellm.eladrave.com
# LITELLM_MODEL=chatgpt/gpt-5.6-terra-high
# Build-only GitHub credential (never passed to the running container).
CYNAPSA_GITHUB_TOKEN=replace-with-github-token

# Optional local metrics: start observability/ and set the host-shell
# CYNAPSA_DEMO_DOCKER_NETWORK=cynapsa-observability before ./run.sh.
# CYNAPSA_CORE_OTLP_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics
# CYNAPSA_CORE_OTLP_METRICS_INSECURE_DEV=1
# CYNAPSA_SDK_OTLP_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics
# CYNAPSA_SDK_OTLP_METRICS_INSECURE_DEV=1
# CYNAPSA_CORE_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
# CYNAPSA_CORE_OTLP_TRACES_INSECURE_DEV=1
# CYNAPSA_SDK_OTLP_EVENTS_ENDPOINT=http://otel-collector:4318
# CYNAPSA_SDK_OTLP_EVENTS_INSECURE_DEV=1
