# syntax=docker/dockerfile:1.7

FROM golang:1.26.6-bookworm AS core-build
WORKDIR /core
COPY --from=core . .
RUN go build -trimpath -buildmode=c-shared \
    -ldflags="-extldflags=-Wl,--version-script,/core/cmd/cynapsacore-shared/exports_linux.map" \
    -o /out/libcynapsacore.so ./cmd/cynapsacore-shared

FROM python:3.13-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CYNAPSA_CORE_LIBRARY=/opt/cynapsa/libcynapsacore.so \
    CYNAPSA_STATE_DIRECTORY=/var/lib/cynapsa \
    SSL_CERT_FILE=/run/cynapsa/ca.pem \
    PYTHONPATH=/workspace
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 cynapsa
WORKDIR /sdk
COPY pyproject.toml README.md /sdk/
COPY src /sdk/src
RUN python -m pip install --no-cache-dir '/sdk[client]' 'fastapi>=0.115' 'uvicorn>=0.30,<1'
COPY examples/manual_mesh /workspace/manual_mesh
COPY --from=core-build /out/libcynapsacore.so /opt/cynapsa/libcynapsacore.so
RUN chmod -R 0555 /workspace/manual_mesh /opt/cynapsa/libcynapsacore.so \
    && mkdir -p /var/lib/cynapsa \
    && chown 10001:10001 /var/lib/cynapsa
USER 10001:10001
