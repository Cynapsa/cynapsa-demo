# Relevant fragment for the dedicated single-node Cynapsa authority vhost.
# Merge with the deployment's TLS/auth/listener settings.
hosts:
  - mesh.test

# Exact resource identity must never be substituted on collision.
resource_conflict: closeold

# The dedicated upload listener must gate local PUT/GET/HEAD requests through
# the mesh module so removal serializes with an already-consumed upload slot.
listen:
  -
    port: 5443
    module: ejabberd_http
    tls: true
    request_handlers:
      /upload: mod_cynapsa_mesh

modules:
  # Mesh-scoped removal cleanup is implemented against the pinned Mnesia
  # records. Other backends fail module startup rather than retaining data.
  mod_mam:
    db_type: mnesia
    # The dedicated mesh plane is not an application archive. Membership
    # controls and application payloads must never enter cross-session replay.
    assume_mam_usage: false
    default: never
    request_activates_archiving: false
  mod_offline:
    db_type: mnesia
  mod_roster: {}
  mod_shared_roster:
    db_type: mnesia
  mod_stream_mgmt:
    resend_on_timeout: if_offline
  mod_time: {}
  mod_http_upload:
    # Supply the deployment's TLS URL and private document root.
    put_url: "https://@HOST@:5443/upload"
    # V1 public payload ceiling (134217696) plus 64 authenticated bytes.
    max_size: 134217760
  mod_admin_extra: {}
  mod_cynapsa_mesh:
    # A membership control must receive an exact-session processed IQ result
    # within this bound or that exact c2s session is closed.
    control_ack_timeout_seconds: 5
    control_pending_max: 65536
    # Exact user@host/resource mailbox limits. Rows are retained independently
    # of XMPP session IDs and are charged until destination SM acknowledgement.
    mailbox_max_messages: 1024
    mailbox_max_bytes: 67108864
    mailbox_retention_seconds: 86400
    # Metadata-only admission/custody/dispatch and deletion-on-ACK events.
    mailbox_audit_log: false
