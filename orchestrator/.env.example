# Required only while enrolling a new state volume.
CYNAPSA_TOKEN=replace-with-orchestrator-enrollment-token

# Required on every run, unless .private/litellm_api_key is present.
# LITELLM_API_KEY=replace-with-gateway-api-key

# Required routing configuration.
DEMO_MESH_ID=replace-with-mesh-id
# Optional mode switch; the default is the first command.
# DEMO_RUN_COMMAND=cynapsa run --config /tmp/cynapsa-private/cynapsa.json -- app:app
# DEMO_RUN_COMMAND=uvicorn app:app --host 127.0.0.1 --port 8000 --no-access-log
DEMO_MAPS_AGENT_ID=replace-with-maps-agent-id@connect.cynapsa.com
# Optional; enables the independent files agent tool.
DEMO_FILES_AGENT_ID=
# Optional friendly label for incoming client log lines.
# DEMO_CLIENT_AGENT_ID=replace-with-client-agent-id@connect.cynapsa.com
# Optional origins for outbound HTTP calls. The CLI maps these origins to the
# destination IDs above; direct HTTP mode can point them at real HTTP servers.
# Real Cloud Run Maps URL: same value for direct HTTP and Cynapsa mapping.
DEMO_MAPS_ORIGIN=https://cynapsa-demo-maps-service-144701547770.us-central1.run.app
# DEMO_FILES_ORIGIN=http://demo-files.local

# Optional gateway overrides.
# LITELLM_BASE_URL=https://litellm.eladrave.com
# LITELLM_MODEL=chatgpt/gpt-5.6-terra-high
# Optional container-local directory for SQLite, separate from credential state.
# Defaults to the local Cynapsa state volume.
# DEMO_MEMORY_DIRECTORY=/var/lib/cynapsa-memory
# Build-only GitHub credential (never passed to the running container).
CYNAPSA_GITHUB_TOKEN=replace-with-github-token
