# syntax=docker/dockerfile:1.7

FROM golang:1.26.6-bookworm AS core-build
WORKDIR /core
COPY --from=core . .
RUN go build -trimpath -buildmode=c-shared \
    -ldflags="-extldflags=-Wl,--version-script,/core/cmd/cynapsacore-shared/exports_linux.map" \
    -o /out/libcynapsacore.so ./cmd/cynapsacore-shared

FROM python:3.13-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CYNAPSA_CORE_LIBRARY=/opt/cynapsa/libcynapsacore.so \
    SSL_CERT_FILE=/ca.pem
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 e2e
WORKDIR /sdk
COPY pyproject.toml README.md /sdk/
COPY src /sdk/src
RUN python -m pip install --no-cache-dir '/sdk[test]' 'uvicorn>=0.30,<1'
COPY . /sdk
COPY --from=core-build /out/libcynapsacore.so /opt/cynapsa/libcynapsacore.so
COPY e2e/simple/cynapsa_e2e /opt/cynapsa-e2e/cynapsa_e2e
ENV PYTHONPATH=/opt/cynapsa-e2e
RUN chmod -R 0555 /opt/cynapsa-e2e \
    && chmod 0555 /opt/cynapsa/libcynapsacore.so
USER 10001:10001
